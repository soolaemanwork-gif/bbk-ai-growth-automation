# =========================================================
# BBKitchen — Public Repository Ignore Rules
# =========================================================

# Environment variables
.env
.env.*
!.env.example

# Credentials / secrets
credentials.json
service-account.json
config_telethon.py
*.pem
*.key

# Telegram authentication
*.session
*.session-journal

# Raw Telegram / supplier data
exports/
result.json

# Production media
*.jpg
*.jpeg
*.webp

# Local runtime files
archive/
logs/
*.log

# Python cache
__pycache__/
*.py[cod]

# Virtual environments
venv/
.venv/
env/

# IDE / editor
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
